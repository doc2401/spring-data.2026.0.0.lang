    {
      "source": "a <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/function/Consumer.html\" title=\"class or interface in java.util.function\"><code>Consumer</code></a> to customize the <a href=\"../util/TypeCollector.html\" title=\"class in org.springframework.data.util\"><code>TypeCollector</code></a>, must not be null.",
