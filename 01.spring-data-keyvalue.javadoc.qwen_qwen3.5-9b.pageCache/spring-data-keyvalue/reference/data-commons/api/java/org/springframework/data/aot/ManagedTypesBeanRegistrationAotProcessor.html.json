      "count": 1
    },
    {
      "source": "<code><a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/context/EnvironmentAware.html#setEnvironment(org.springframework.core.env.Environment)\" title=\"class or interface in org.springframework.context\">setEnvironment</a></code> in interface <code><a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/context/EnvironmentAware.html\" title=\"class or interface in org.springframework.context\">EnvironmentAware</a></code>",
