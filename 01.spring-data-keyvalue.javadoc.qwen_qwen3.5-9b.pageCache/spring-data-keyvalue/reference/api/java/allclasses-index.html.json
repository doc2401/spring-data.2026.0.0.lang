    {
      "source": "<a class=\"external-link\" href=\"https://docs.spring.io/spring-data/commons/docs/current/api/org/springframework/data/repository/core/support/RepositoryFactorySupport.html\" title=\"class or interface in org.springframework.data.repository.core.support\"><code>RepositoryFactorySupport</code></a> specific of handing\n<a href=\"org/springframework/data/keyvalue/repository/KeyValueRepository.html\" title=\"interface in org.springframework.data.keyvalue.repository\"><code>KeyValueRepository</code></a>.",
