      "count": 1
    },
    {
      "source": "<a class=\"external-link\" href=\"https://docs.spring.io/spring-data/commons/docs/current/api/org/springframework/data/querydsl/QuerydslPredicateExecutor.html\" title=\"class or interface in org.springframework.data.querydsl\"><code>QuerydslPredicateExecutor</code></a> capable of applying <code>Predicate</code>s using <code>CollQuery</code>.",
