      "count": 2
    },
    {
      "source": "Compute the <code>GridFSUploadOptions</code> to be used from the given contentType and metadata\n<code>Document</code>.",
      "translation": "根据给定的 contentType 和元数据 <code>Document</code>，计算用于的 <code>GridFSUploadOptions</code>。",
      "count": 2
    },
    {
      "source": "Deletes all files matching the given <a href=\"../core/query/Query.html\" title=\"class in org.springframework.data.mongodb.core.query\"><code>Query</code></a>.",
      "translation": "删除所有与给定<a href=\"../core/query/Query.html\" title=\"class in org.springframework.data.mongodb.core.query\"><code>Query</code></a>匹配的文件。",
      "count": 2
    },
    {
      "source": "Returns the <a href=\"GridFsResource.html\" title=\"class in org.springframework.data.mongodb.gridfs\"><code>GridFsResource</code></a> with the given file name.",
      "translation": "返回具有给定文件名的<a href=\"GridFsResource.html\" title=\"class in org.springframework.data.mongodb.gridfs\"><code>GridFsResource</code></a>。",
      "count": 2
    },
    {
      "source": "Returns all <a href=\"GridFsResource.html\" title=\"class in org.springframework.data.mongodb.gridfs\"><code>GridFsResource</code></a>s matching the given file name pattern.",
      "translation": "返回所有与给定文件名模式匹配的<a href=\"GridFsResource.html\" title=\"class in org.springframework.data.mongodb.gridfs\"><code>GridFsResource</code></a>。",
      "count": 2
    },
    {
      "source": "Returns a single <code>GridFSFile</code> matching the given query or null in\ncase no file matches.",
