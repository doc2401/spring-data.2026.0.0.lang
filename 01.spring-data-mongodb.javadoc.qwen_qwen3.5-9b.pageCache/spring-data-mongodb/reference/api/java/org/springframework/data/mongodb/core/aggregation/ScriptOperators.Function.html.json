      "count": 1
    },
    {
      "source": "<ul class=\"tag-list-long\">\n<li><a href=\"https://docs.mongodb.com/master/reference/operator/aggregation/function/\">MongoDB Documentation:\n     $function</a></li>\n</ul>",
      "translation": "<ul class=\"tag-list-long\">\n<li><a href=\"https://docs.mongodb.com/master/reference/operator/aggregation/function/\">MongoDB 文档：$function</a></li>\n</ul>",
