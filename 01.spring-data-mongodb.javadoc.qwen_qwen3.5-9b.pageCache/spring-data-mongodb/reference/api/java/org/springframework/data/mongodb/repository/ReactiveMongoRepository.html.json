    {
      "source": "Mongo specific <a class=\"external-link\" href=\"https://docs.spring.io/spring-data/commons/docs/current/api/org/springframework/data/repository/Repository.html\" title=\"class or interface in org.springframework.data.repository\"><code>Repository</code></a> interface with reactive support.",
