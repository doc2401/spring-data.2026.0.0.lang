    {
      "source": "<a class=\"external-link\" href=\"https://docs.spring.io/spring-data/commons/docs/current/api/org/springframework/data/repository/core/support/RepositoryComposition.RepositoryFragments.html\" title=\"class or interface in org.springframework.data.repository.core.support\"><code>RepositoryComposition.RepositoryFragments</code></a> to be added to the repository.",
