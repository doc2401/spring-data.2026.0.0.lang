    {
      "source": "the <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/beans/factory/support/RootBeanDefinition.html\" title=\"class or interface in org.springframework.beans.factory.support\"><code>RootBeanDefinition</code></a> for the given, required <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/String.html\" title=\"class or interface in java.lang\"><code>bean name</code></a>.",
