    {
      "source": "<span id=\"type-param-T\"><code>T</code> - the type of the repository.</span>",
      "translation": "<span id=\"type-param-T\"><code>T</code> - 仓库的类型。</span>",
      "count": 1
    },
    {
      "source": "<span id=\"type-param-S\"><code>S</code> - the entity type.</span>",
      "translation": "<span id=\"type-param-S\"><code>S</code> - 实体类型。</span>",
      "count": 1
    },
    {
      "source": "<span id=\"type-param-ID\"><code>ID</code> - the entity identifier type.</span>",
      "translation": "<span id=\"type-param-ID\"><code>ID</code> - 实体标识符类型。</span>",
      "count": 1
    },
    {
      "source": "<code>repositoryInterface</code> - must not be null.",
      "translation": "<code>repositoryInterface</code> 不能为 null。",
      "count": 1
    },
    {
      "source": "<code>repositoryBaseClass</code> - the repositoryBaseClass to set, can be null.",
      "translation": "<code>repositoryBaseClass</code> - 要设置的基类，可为 null。",
      "count": 1
    },
    {
      "source": "<code>queryLookupStrategyKey</code> - the lookup strategy key to be used.",
      "translation": "<code>queryLookupStrategyKey</code> - 要使用的查找策略键。",
      "count": 1
    },
    {
      "source": "<code>customImplementation</code> - the single custom implementation.",
      "translation": "<code>customImplementation</code> - 单个自定义实现。",
      "count": 1
    },
    {
      "source": "<code>repositoryFragments</code> - the repository fragments to be used.",
      "translation": "<code>repositoryFragments</code> - 要使用的仓库片段。",
      "count": 1
    },
    {
      "source": "<code>fragmentsFunction</code> - function to derive additional repository fragments.",
      "translation": "`fragmentsFunction` - 用于派生额外仓库片段的函数。",
      "count": 1
    },
    {
      "source": "<code>namedQueries</code> - the namedQueries to set.",
      "translation": "<code>namedQueries</code> - 要设置的命名查询。",
      "count": 1
    },
    {
      "source": "<code>mappingContext</code> - mapping context to be used.",
      "translation": "<code>mappingContext</code> - 要使用的映射上下文。",
      "count": 1
    },
    {
      "source": "<code>evaluationContextProvider</code> - must not be null.",
      "translation": "<code>evaluationContextProvider</code> 不能为 null。",
      "count": 1
    },
    {
      "source": "<code>customizer</code> - must not be null.",
      "translation": "<code>customizer</code> 不能为 null。",
      "count": 1
    },
    {
      "source": "<code>lazy</code> - whether to initialize the repository proxy lazily. This defaults to false.",
      "translation": "<code>lazy</code> - 是否延迟初始化仓库代理。默认值为 false。",
      "count": 1
    },
    {
      "source": "<code>beanFactory</code> - the bean factory to use.",
      "translation": "<code>beanFactory</code> - 要使用的 Bean 工厂。",
      "count": 1
    },
    {
      "source": "the default instance. May be <code>null</code>.",
      "translation": "默认实例。可为 null。",
      "count": 1
    },
    {
      "source": "Oliver Gierke, Thomas Darimont, Mark Paluch, Johannes Englmeier",
      "translation": "Oliver Gierke，Thomas Darimont，Mark Paluch，Johannes Englmeier",
      "count": 1
    },
    {
      "source": "the repository factory.",
      "translation": "仓库工厂。",
      "count": 1
    },
    {
      "source": "Nested Class Summary",
      "translation": "嵌套类摘要",
      "count": 1
    },
    {
      "source": "Adapter for Spring's <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/beans/factory/FactoryBean.html\" title=\"class or interface in org.springframework.beans.factory\"><code>FactoryBean</code></a> interface to allow easy setup of repository factories via Spring\nconfiguration.",
      "translation": "适用于 Spring 的 <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/beans/factory/FactoryBean.html\" title=\"org.springframework.beans.factory 中的类或接口\"><code>FactoryBean</code></a> 接口的适配器，允许通过 Spring 配置轻松设置存储库工厂。",
      "count": 1
    },
    {
      "source": "Set whether the repository method metadata should be exposed by the repository factory as a ThreadLocal for\nretrieval via the <code>RepositoryMethodContext</code> class. This is useful if an advised object needs to obtain\nrepository information.",
      "translation": "设置是否将仓库方法元数据作为 ThreadLocal 由仓库工厂暴露，以便通过<code>RepositoryMethodContext</code>类进行检索。如果建议的对象需要获取仓库信息，这将非常有用。",
      "count": 1
    }
  ]
}