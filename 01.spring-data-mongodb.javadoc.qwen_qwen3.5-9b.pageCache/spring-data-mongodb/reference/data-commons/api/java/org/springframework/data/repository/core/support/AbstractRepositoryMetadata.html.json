  "items": [
    {
      "source": "Creates a new <a href=\"AbstractRepositoryMetadata.html\" title=\"class in org.springframework.data.repository.core.support\"><code>AbstractRepositoryMetadata</code></a>.",
      "translation": "创建一个新的<a href=\"AbstractRepositoryMetadata.html\" title=\"org.springframework.data.repository.core.support 中的类\"><code>AbstractRepositoryMetadata</code></a>。",
      "count": 2
    },
    {
      "source": "Returns <a href=\"../CrudMethods.html\" title=\"interface in org.springframework.data.repository.core\"><code>CrudMethods</code></a> meta information for the repository.",
      "translation": "返回存储库的<a href=\"../CrudMethods.html\" title=\"org.springframework.data.repository.core 中的接口\"><code>CrudMethods</code></a>元信息。",
      "count": 2
    },
    {
      "source": "Creates a new <a href=\"../RepositoryMetadata.html\" title=\"interface in org.springframework.data.repository.core\"><code>RepositoryMetadata</code></a> for the given repository interface.",
      "translation": "为给定的存储库接口创建一个新的<a href=\"../RepositoryMetadata.html\" title=\"org.springframework.data.repository.core 中的接口\"><code>RepositoryMetadata</code></a>。",
      "count": 2
    },
    {
      "source": "Returns the set of types the repository shall be discoverable for when trying to look up a repository by domain\ntype.",
      "translation": "返回当尝试通过域类型查找仓库时，该仓库应可被发现的类型集合。",
      "count": 2
    },
    {
      "source": "Returns the repository interface.",
      "translation": "返回仓库接口。",
      "count": 2
    },
    {
      "source": "Returns whether the repository is a paging one.",
      "translation": "返回该仓库是否为分页类型。",
      "count": 2
    },
    {
      "source": "Returns whether the repository is a reactive one, i.e. if it uses reactive types in one of its methods.",
      "translation": "返回该仓库是否为响应式仓库，即其方法中是否使用了响应式类型。",
      "count": 2
    },
