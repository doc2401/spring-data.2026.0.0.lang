      "count": 2
    },
    {
      "source": "Initialize the <a href=\"Cursor.html\" title=\"interface in org.springframework.data.redis.core\"><code>Cursor</code></a> prior to usage.",
      "translation": "在使用之前，请初始化<a href=\"Cursor.html\" title=\"org.springframework.data.redis.core 中的接口\"><code>Cursor</code></a>。",
      "count": 2
    },
    {
