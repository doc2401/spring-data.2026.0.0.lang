    {
      "source": "Absent passwords return a <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/Optional.html#empty()\" title=\"class or interface in java.util\"><code>Optional.empty()</code></a>.",
      "translation": "缺失的密码会返回一个 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/Optional.html#empty()\" title=\"class or interface in java.util\"><code>Optional.empty()</code></a>。",
      "count": 2
    },
    {
      "source": "Map the password using a <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/function/Function.html\" title=\"class or interface in java.util.function\"><code>Function</code></a> and return a <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/Optional.html\" title=\"class or interface in java.util\"><code>Optional</code></a> containing the mapped value.",
      "translation": "使用一个 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/function/Function.html\" title=\"class or interface in java.util.function\"><code>Function</code></a> 对密码进行映射，并返回一个包含映射值的 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/Optional.html\" title=\"class or interface in java.util\"><code>Optional</code></a>。",
      "count": 2
    },
    {
      "source": "Create a <a href=\"RedisPassword.html\" title=\"class in org.springframework.data.redis.connection\"><code>RedisPassword</code></a> from a <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/String.html\" title=\"class or interface in java.lang\"><code>String</code></a>.",
      "translation": "根据 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/String.html\" title=\"类或接口 java.lang\"><code>String</code></a> 创建一个 <a href=\"RedisPassword.html\" title=\"org.springframework.data.redis.connection 中的类\"><code>RedisPassword</code></a>。",
      "count": 2
    },
    {
      "source": "Create a <a href=\"RedisPassword.html\" title=\"class in org.springframework.data.redis.connection\"><code>RedisPassword</code></a> from a <code>char</code> array.",
      "translation": "从 <code>char</code> 数组创建<a href=\"RedisPassword.html\" title=\"class in org.springframework.data.redis.connection\"><code>RedisPassword</code></a>。",
      "count": 2
    },
    {
      "source": "Return <code>true</code> if there is a password present, otherwise <code>false</code>.",
      "translation": "如果存在密码，则返回 <code>true</code>；否则返回 <code>false</code>。",
      "count": 2
    },
    {
      "source": "Create an absent <a href=\"RedisPassword.html\" title=\"class in org.springframework.data.redis.connection\"><code>RedisPassword</code></a>.",
      "translation": "创建一个缺失的<a href=\"RedisPassword.html\" title=\"org.springframework.data.redis.connection 中的类\"><code>RedisPassword</code></a>。",
      "count": 2
    },
    {
      "source": "Adopt the password to <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/Optional.html\" title=\"class or interface in java.util\"><code>Optional</code></a> containing the password value.",
      "translation": "采用包含密码值的 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/Optional.html\" title=\"class or interface in java.util\"><code>Optional</code></a> 作为密码。",
      "count": 2
    },
    {
      "source": "If a password is present, <code>isPresent()</code> will return <code>true</code> and <code>get()</code> will return the value.",
      "translation": "如果存在密码，<code>isPresent()</code> 将返回 <code>true</code>，而 <code>get()</code> 将返回该值。",
      "count": 1
    },
