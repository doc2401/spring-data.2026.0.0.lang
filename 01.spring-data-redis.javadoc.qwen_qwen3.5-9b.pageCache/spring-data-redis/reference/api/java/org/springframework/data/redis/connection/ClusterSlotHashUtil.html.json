    {
      "source": "<code>keys</code> - <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/Collection.html\" title=\"class or interface in java.util\"><code>Collection</code></a> of <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/nio/ByteBuffer.html\" title=\"class or interface in java.nio\"><code>ByteBuffer</code></a> objects containing the keys to evaluate; must not be\n         null.",
