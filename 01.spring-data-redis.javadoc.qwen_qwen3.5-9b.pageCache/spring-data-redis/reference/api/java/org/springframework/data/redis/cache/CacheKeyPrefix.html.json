      "translation": "默认分隔符。",
      "count": 2
    },
    {
      "source": "the default <a href=\"CacheKeyPrefix.html\" title=\"interface in org.springframework.data.redis.cache\"><code>CacheKeyPrefix</code></a> scheme.",
      "translation": "默认的<a href=\"CacheKeyPrefix.html\" title=\"org.springframework.data.redis.cache 中的接口\"><code>CacheKeyPrefix</code></a>方案。",
      "count": 2
    },
    {
