    {
      "source": "Create an <a href=\"RedisStreamCommands.XDelOptions.html\" title=\"class in org.springframework.data.redis.connection\"><code>RedisStreamCommands.XDelOptions</code></a> instance with default options.",
      "translation": "创建一个具有默认选项的<a href=\"RedisStreamCommands.XDelOptions.html\" title=\"class in org.springframework.data.redis.connection\"><code>RedisStreamCommands.XDelOptions</code></a>实例。",
      "count": 2
    },
    {
