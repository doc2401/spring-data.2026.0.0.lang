      "count": 2
    },
    {
      "source": "Serialize the given <code>element</code> to its <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/nio/ByteBuffer.html\" title=\"class or interface in java.nio\"><code>ByteBuffer</code></a> representation.",
