    {
      "source": "Create and set a <a href=\"RedisPassword.html\" title=\"class in org.springframework.data.redis.connection\"><code>RedisPassword</code></a> for given <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/String.html\" title=\"class or interface in java.lang\"><code>String</code></a>.",
