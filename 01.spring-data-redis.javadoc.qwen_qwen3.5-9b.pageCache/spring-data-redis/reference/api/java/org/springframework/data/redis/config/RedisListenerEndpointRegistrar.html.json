    {
      "source": "<code><a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/beans/factory/InitializingBean.html#afterPropertiesSet()\" title=\"class or interface in org.springframework.beans.factory\">afterPropertiesSet</a></code> in interface <code><a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/beans/factory/InitializingBean.html\" title=\"class or interface in org.springframework.beans.factory\">InitializingBean</a></code>",
      "translation": "<code><a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/beans/factory/InitializingBean.html#afterPropertiesSet()\" title=\"类或接口，位于 org.springframework.beans.factory\">afterPropertiesSet</a></code> 是接口<code><a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/beans/factory/InitializingBean.html\" title=\"类或接口，位于 org.springframework.beans.factory\">InitializingBean</a></code>中的方法",
      "count": 1
    },
    {
      "source": "<code>validator</code> - the <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/validation/Validator.html\" title=\"class or interface in org.springframework.validation\"><code>Validator</code></a> to configure",
      "translation": "<code>validator</code> - 用于配置的 <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/validation/Validator.html\" title=\"class or interface in org.springframework.validation\"><code>Validator</code></a>",
      "count": 1
    },
    {
      "source": "<code>conversionService</code> - the <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/core/convert/ConversionService.html\" title=\"class or interface in org.springframework.core.convert\"><code>ConversionService</code></a> to configure. Can be null to use the default.",
      "translation": "<code>conversionService</code> - 要配置的 <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/core/convert/ConversionService.html\" title=\"class or interface in org.springframework.core.convert\"><code>ConversionService</code></a>。可设为 null 以使用默认值。",
      "count": 1
    },
    {
      "source": "<code>messageConverter</code> - the <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/messaging/converter/MessageConverter.html\" title=\"class or interface in org.springframework.messaging.converter\"><code>MessageConverter</code></a> to configure",
      "translation": "<code>messageConverter</code> - 用于配置的 <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/messaging/converter/MessageConverter.html\" title=\"class or interface in org.springframework.messaging.converter\"><code>MessageConverter</code></a>",
      "count": 1
    },
    {
      "source": "<code>endpoint</code> - the <a href=\"RedisListenerEndpoint.html\" title=\"interface in org.springframework.data.redis.config\"><code>RedisListenerEndpoint</code></a> to register",
      "translation": "<code>endpoint</code> - 要注册的 <a href=\"RedisListenerEndpoint.html\" title=\"org.springframework.data.redis.config 中的接口\"><code>RedisListenerEndpoint</code></a>",
