      "count": 1
    },
    {
      "source": "an unmodifiable <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/Set.html\" title=\"class or interface in java.util\"><code>Set</code></a> holding the name of caches for which a <a href=\"RedisCacheConfiguration.html\" title=\"class in org.springframework.data.redis.cache\"><code>configuration</code></a> has been set.",
