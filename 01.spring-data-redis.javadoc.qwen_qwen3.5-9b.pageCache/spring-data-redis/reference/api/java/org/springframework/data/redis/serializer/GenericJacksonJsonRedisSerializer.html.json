    {
      "source": "<code><a href=\"SerializationException.html\" title=\"class in org.springframework.data.redis.serializer\">SerializationException</a></code> - if the array of bytes cannot be deserialized as an instance of the given\n          <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Class.html\" title=\"class or interface in java.lang\"><code>type</code></a>",
