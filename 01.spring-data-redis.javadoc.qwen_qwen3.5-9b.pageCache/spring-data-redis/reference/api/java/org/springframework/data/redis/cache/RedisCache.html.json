      "count": 2
    },
    {
      "source": "Loads the <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Object.html\" title=\"class or interface in java.lang\"><code>Object</code></a> using the given <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/concurrent/Callable.html\" title=\"class or interface in java.util.concurrent\"><code>valueLoader</code></a>.",
