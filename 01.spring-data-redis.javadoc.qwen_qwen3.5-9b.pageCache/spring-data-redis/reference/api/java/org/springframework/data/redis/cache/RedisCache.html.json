    {
      "source": "<code><a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/cache/support/AbstractValueAdaptingCache.html#lookup(java.lang.Object)\" title=\"class or interface in org.springframework.cache.support\">lookup</a></code> in class <code><a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/cache/support/AbstractValueAdaptingCache.html\" title=\"class or interface in org.springframework.cache.support\">AbstractValueAdaptingCache</a></code>",
