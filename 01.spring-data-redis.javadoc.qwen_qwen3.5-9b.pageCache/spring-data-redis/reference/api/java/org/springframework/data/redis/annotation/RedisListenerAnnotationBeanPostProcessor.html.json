      "translation": "<small>版权所有 © 2011–2026 <a href=\"https://www.spring.io\">Pivotal Software, Inc.</a>。保留所有权利。</small>",
      "count": 1
    },
    {
      "source": "Annotated methods can use flexible arguments as defined by <a href=\"RedisListener.html\" title=\"annotation interface in org.springframework.data.redis.annotation\"><code>RedisListener</code></a>.",
      "translation": "注解方法可以使用由<a href=\"RedisListener.html\" title=\"org.springframework.data.redis.annotation 中的注解接口\"><code>RedisListener</code></a>定义的灵活参数。",
      "count": 1
    },
    {
      "source": "This post-processor is automatically registered by Spring's by the <a href=\"EnableRedisListeners.html\" title=\"annotation interface in org.springframework.data.redis.annotation\"><code>EnableRedisListeners</code></a> annotation.",
      "translation": "此后置处理器由 Spring 通过<a href=\"EnableRedisListeners.html\" title=\"org.springframework.data.redis.annotation 包中的注解接口\"><code>EnableRedisListeners</code></a>注解自动注册。",
      "count": 1
    },
    {
      "source": "See the <a href=\"EnableRedisListeners.html\" title=\"annotation interface in org.springframework.data.redis.annotation\"><code>EnableRedisListeners</code></a> javadocs for complete usage details.",
      "translation": "有关完整的使用说明，请参阅<a href=\"EnableRedisListeners.html\" title=\"org.springframework.data.redis.annotation 包中的注解接口\"><code>EnableRedisListeners</code></a>的 JavaDoc。",
      "count": 1
    },
