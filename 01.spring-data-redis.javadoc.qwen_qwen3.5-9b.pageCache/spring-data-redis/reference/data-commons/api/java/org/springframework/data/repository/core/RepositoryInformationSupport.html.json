    {
      "source": "Returns <a href=\"CrudMethods.html\" title=\"interface in org.springframework.data.repository.core\"><code>CrudMethods</code></a> meta information for the repository.",
      "translation": "返回存储库的<a href=\"CrudMethods.html\" title=\"org.springframework.data.repository.core 中的接口\"><code>CrudMethods</code></a>元信息。",
      "count": 2
    },
    {
      "source": "Returns the <a href=\"../../core/TypeInformation.html\" title=\"interface in org.springframework.data.core\"><code>TypeInformation</code></a> of the id type of the repository.",
      "translation": "返回存储库的 ID 类型的<a href=\"../../core/TypeInformation.html\" title=\"org.springframework.data.core 中的接口\"><code>TypeInformation</code></a>。",
      "count": 2
    },
    {
      "source": "Returns the set of types the repository shall be discoverable for when trying to look up a repository by domain\ntype.",
      "translation": "返回当尝试通过域类型查找仓库时，该仓库应可被发现的类型集合。",
      "count": 2
    },
    {
      "source": "Returns the raw domain class the repository is declared for.",
      "translation": "返回仓库声明的原始域类。",
      "count": 2
    },
    {
      "source": "Returns the raw id class the given class is declared for.",
      "translation": "返回给定类所声明的原始 ID 类。",
      "count": 2
    },
    {
      "source": "Returns all methods considered to be query methods.",
      "translation": "返回所有被视为查询方法的方法。",
      "count": 2
    },
    {
      "source": "Returns the base class to be used to create the proxy backing instance.",
      "translation": "返回用于创建代理后备实例的基类。",
      "count": 2
    },
    {
      "source": "Returns the repository interface.",
      "translation": "返回仓库接口。",
      "count": 2
    },
    {
      "source": "Returns whether the configured repository interface has query methods at all.",
      "translation": "返回配置的存储库接口是否包含任何查询方法。",
      "count": 2
    },
    {
      "source": "Returns whether the given type name is a repository interface name.",
      "translation": "返回给定的类型名称是否为存储库接口名称。",
      "count": 2
    },
    {
      "source": "Returns whether the repository is a paging one.",
      "translation": "返回该仓库是否为分页仓库。",
      "count": 2
    },
    {
      "source": "Returns whether the given method is a query method.",
      "translation": "返回给定的方法是否为查询方法。",
      "count": 2
    },
    {
      "source": "Checks whether the given method is a query method candidate.",
      "translation": "检查给定的方法是否为查询方法候选。",
      "count": 2
    },
    {
      "source": "Returns whether the repository is a reactive one, i.e. if it uses reactive types in one of its methods.",
      "translation": "返回该仓库是否为响应式仓库，即其方法中是否使用了响应式类型。",
      "count": 2
    },
