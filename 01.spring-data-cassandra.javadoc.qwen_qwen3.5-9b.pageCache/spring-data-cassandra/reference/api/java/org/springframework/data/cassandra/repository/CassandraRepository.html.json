      "source": "<h1 class=\"title\" title=\"Interface CassandraRepository\">Interface CassandraRepository&lt;<span id=\"type-param-T\">T</span>,<wbr/><span id=\"type-param-ID\">ID</span>&gt;</h1>",
      "translation": "<h1 class=\"title\" title=\"接口 CassandraRepository\">接口 CassandraRepository&lt;<span id=\"type-param-T\">T</span>,<wbr/><span id=\"type-param-ID\">ID</span>&gt;</h1>",
      "count": 1
