    {
      "source": "Returns the underlying <a href=\"../mapping/CassandraPersistentProperty.html\" title=\"interface in org.springframework.data.cassandra.core.mapping\"><code>CassandraPersistentProperty</code></a> backing the field.",
      "translation": "返回底层支持该字段的<a href=\"../mapping/CassandraPersistentProperty.html\" title=\"org.springframework.data.cassandra.core.mapping 中的接口\"><code>CassandraPersistentProperty</code></a>。",
