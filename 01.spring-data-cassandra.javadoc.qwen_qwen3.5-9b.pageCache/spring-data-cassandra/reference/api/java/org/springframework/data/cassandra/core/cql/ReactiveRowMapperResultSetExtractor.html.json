    {
      "source": "Create a new <a href=\"ReactiveRowMapperResultSetExtractor.html\" title=\"class in org.springframework.data.cassandra.core.cql\"><code>ReactiveRowMapperResultSetExtractor</code></a>.",
      "translation": "创建一个新的<a href=\"ReactiveRowMapperResultSetExtractor.html\" title=\"class in org.springframework.data.cassandra.core.cql\"><code>ReactiveRowMapperResultSetExtractor</code></a>。",
      "count": 2
    },
    {
      "source": "Implementations must implement this method to process the entire <a href=\"../../ReactiveResultSet.html\" title=\"interface in org.springframework.data.cassandra\"><code>ReactiveResultSet</code></a>.",
