    {
      "source": "<h1 class=\"title\" title=\"Interface PageableArgumentResolver\">Interface PageableArgumentResolver</h1>",
      "translation": "<h1 class=\"title\" title=\"接口 PageableArgumentResolver\">接口 PageableArgumentResolver</h1>",
      "count": 1
    },
    {
      "source": "Spring Data Core",
      "translation": "Spring Data 核心",
      "count": 1
    },
    {
      "source": "Modifier and Type",
      "translation": "修改类型",
      "count": 1
