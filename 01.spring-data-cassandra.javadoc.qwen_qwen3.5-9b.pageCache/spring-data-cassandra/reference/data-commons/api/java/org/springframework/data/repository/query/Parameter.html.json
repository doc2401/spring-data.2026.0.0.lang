      "source": "<li><a href=\"#\" tabindex=\"0\">Description</a></li>\n<li><a href=\"#constructor-summary\" tabindex=\"0\">Constructor Summary</a></li>\n<li><a href=\"#method-summary\" tabindex=\"0\">Method Summary</a></li>\n<li><a href=\"#constructor-detail\" tabindex=\"0\">Constructor Details</a>\n<ol class=\"toc-list\">\n<li><a href=\"#%3Cinit%3E(org.springframework.core.MethodParameter,org.springframework.data.core.TypeInformation)\" tabindex=\"0\">Parameter(MethodParameter, TypeInformation)</a></li>\n</ol>\n</li>\n<li><a href=\"#method-detail\" tabindex=\"0\">Method Details</a>\n<ol class=\"toc-list\">\n<li><a href=\"#isSpecialParameter()\" tabindex=\"0\">isSpecialParameter()</a></li>\n<li><a href=\"#isBindable()\" tabindex=\"0\">isBindable()</a></li>\n<li><a href=\"#isDynamicProjectionParameter()\" tabindex=\"0\">isDynamicProjectionParameter()</a></li>\n<li><a href=\"#getPlaceholder()\" tabindex=\"0\">getPlaceholder()</a></li>\n<li><a href=\"#getIndex()\" tabindex=\"0\">getIndex()</a></li>\n<li><a href=\"#isNamedParameter()\" tabindex=\"0\">isNamedParameter()</a></li>\n<li><a href=\"#isExplicitlyNamed()\" tabindex=\"0\">isExplicitlyNamed()</a></li>\n<li><a href=\"#getName()\" tabindex=\"0\">getName()</a></li>\n<li><a href=\"#getRequiredName()\" tabindex=\"0\">getRequiredName()</a></li>\n<li><a href=\"#getType()\" tabindex=\"0\">getType()</a></li>\n<li><a href=\"#toString()\" tabindex=\"0\">toString()</a></li>\n</ol>\n</li>",
