      "source": "<h1 class=\"title\" title=\"Class RepositoryConfigurationDelegate\">Class RepositoryConfigurationDelegate</h1>",
      "translation": "<h1 class=\"title\" title=\"类 RepositoryConfigurationDelegate\">类 RepositoryConfigurationDelegate</h1>",
