      "source": "<h1 class=\"title\" title=\"Class SimpleTypeInformationMapper\">Class SimpleTypeInformationMapper</h1>",
      "translation": "<h1 class=\"title\" title=\"类 SimpleTypeInformationMapper\">类 SimpleTypeInformationMapper</h1>",
      "count": 1
