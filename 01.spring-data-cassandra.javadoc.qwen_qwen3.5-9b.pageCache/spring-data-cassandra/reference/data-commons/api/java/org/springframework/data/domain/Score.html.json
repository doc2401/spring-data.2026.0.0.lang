      "translation": "<small>版权所有 © 2011–2026 <a href=\"https://www.spring.io\">Pivotal Software, Inc.</a>。保留所有权利。</small>",
      "count": 2
    },
    {
      "source": "Instances of this class are immutable and suitable for use in comparison, sorting, and range operations.",
      "translation": "该类实例是不可变的，适用于比较、排序和范围操作。",
      "count": 2
    },
    {
      "source": "the new <a href=\"Score.html\" title=\"class in org.springframework.data.domain\"><code>Score</code></a>.",
      "translation": "新的<a href=\"Score.html\" title=\"org.springframework.data.domain 中的类\"><code>Score</code></a>。",
      "count": 2
