    {
      "source": "<span class=\"modifiers\">public class </span><span class=\"element-name type-name-label\">ConvertingPropertyAccessor&lt;T&gt;</span>\n<span class=\"extends-implements\">extends <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Object.html\" title=\"class or interface in java.lang\">Object</a></span>",
      "translation": "<span class=\"modifiers\">public class </span><span class=\"element-name type-name-label\">ConvertingPropertyAccessor&lt;T&gt;</span>\n<span class=\"extends-implements\">extends <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Object.html\" title=\"class or interface in java.lang\">Object</a></span>",
