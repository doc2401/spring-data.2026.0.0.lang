      "count": 1
    },
    {
      "source": "<dt>Specified by:</dt>\n<dd><code><a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/transaction/PlatformTransactionManager.html#commit(org.springframework.transaction.TransactionStatus)\" title=\"class or interface in org.springframework.transaction\">commit</a></code> in interface <code><a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/transaction/PlatformTransactionManager.html\" title=\"class or interface in org.springframework.transaction\">PlatformTransactionManager</a></code></dd>\n<dt>Throws:</dt>\n<dd><code><a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/transaction/TransactionException.html\" title=\"class or interface in org.springframework.transaction\">TransactionException</a></code></dd>",
      "translation": "<dt>指定于：</dt>\n<dd><code><a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/transaction/PlatformTransactionManager.html#commit(org.springframework.transaction.TransactionStatus)\" title=\"org.springframework.transaction 中的类或接口\">commit</a></code>，位于接口<code><a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/transaction/PlatformTransactionManager.html\" title=\"org.springframework.transaction 中的类或接口\">PlatformTransactionManager</a></code></dd>\n<dt>抛出：</dt>\n<dd><code><a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/transaction/TransactionException.html\" title=\"org.springframework.transaction 中的类或接口\">TransactionException</a></code></dd>",
      "count": 1
    },
