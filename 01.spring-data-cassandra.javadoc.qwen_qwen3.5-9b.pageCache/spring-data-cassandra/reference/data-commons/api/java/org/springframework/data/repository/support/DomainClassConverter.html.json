      "source": "<span class=\"modifiers\">public class </span><span class=\"element-name type-name-label\">DomainClassConverter&lt;T extends <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/core/convert/ConversionService.html\" title=\"class or interface in org.springframework.core.convert\">ConversionService</a> &amp; <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/core/convert/converter/ConverterRegistry.html\" title=\"class or interface in org.springframework.core.convert.converter\">ConverterRegistry</a>&gt;</span>\n<span class=\"extends-implements\">extends <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Object.html\" title=\"class or interface in java.lang\">Object</a>\nimplements <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/core/convert/converter/ConditionalGenericConverter.html\" title=\"class or interface in org.springframework.core.convert.converter\">ConditionalGenericConverter</a>, <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/context/ApplicationContextAware.html\" title=\"class or interface in org.springframework.context\">ApplicationContextAware</a></span>",
      "translation": "<span class=\"modifiers\">public class </span><span class=\"element-name type-name-label\">DomainClassConverter&lt;T extends <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/core/convert/ConversionService.html\" title=\"class or interface in org.springframework.core.convert\">ConversionService</a> &amp; <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/core/convert/converter/ConverterRegistry.html\" title=\"class or interface in org.springframework.core.convert.converter\">ConverterRegistry</a>&gt;</span>\n<span class=\"extends-implements\">extends <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Object.html\" title=\"class or interface in java.lang\">Object</a>\nimplements <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/core/convert/converter/ConditionalGenericConverter.html\" title=\"class or interface in org.springframework.core.convert.converter\">ConditionalGenericConverter</a>, <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/context/ApplicationContextAware.html\" title=\"class or interface in org.springframework.context\">ApplicationContextAware</a></span>",
      "count": 1
