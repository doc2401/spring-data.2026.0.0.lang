    {
      "source": "<li><a href=\"#\" tabindex=\"0\">Description</a></li>\n<li><a href=\"#constructor-summary\" tabindex=\"0\">Constructor Summary</a></li>\n<li><a href=\"#method-summary\" tabindex=\"0\">Method Summary</a></li>\n<li><a href=\"#constructor-detail\" tabindex=\"0\">Constructor Details</a>\n<ol class=\"toc-list\">\n<li><a href=\"#%3Cinit%3E(org.springframework.data.repository.query.Parameters,java.lang.Object%5B%5D)\" tabindex=\"0\">ParametersParameterAccessor(Parameters, Object[])</a></li>\n</ol>\n</li>\n<li><a href=\"#method-detail\" tabindex=\"0\">Method Details</a>\n<ol class=\"toc-list\">\n<li><a href=\"#getParameters()\" tabindex=\"0\">getParameters()</a></li>\n<li><a href=\"#getValues()\" tabindex=\"0\">getValues()</a></li>\n<li><a href=\"#getVector()\" tabindex=\"0\">getVector()</a></li>\n<li><a href=\"#getScore()\" tabindex=\"0\">getScore()</a></li>\n<li><a href=\"#getScoreRange()\" tabindex=\"0\">getScoreRange()</a></li>\n<li><a href=\"#getScrollPosition()\" tabindex=\"0\">getScrollPosition()</a></li>\n<li><a href=\"#getPageable()\" tabindex=\"0\">getPageable()</a></li>\n<li><a href=\"#getSort()\" tabindex=\"0\">getSort()</a></li>\n<li><a href=\"#getLimit()\" tabindex=\"0\">getLimit()</a></li>\n<li><a href=\"#findDynamicProjection()\" tabindex=\"0\">findDynamicProjection()</a></li>\n<li><a href=\"#getValue(int)\" tabindex=\"0\">getValue(int)</a></li>\n<li><a href=\"#getBindableValue(int)\" tabindex=\"0\">getBindableValue(int)</a></li>\n<li><a href=\"#hasBindableNullValue()\" tabindex=\"0\">hasBindableNullValue()</a></li>\n<li><a href=\"#iterator()\" tabindex=\"0\">iterator()</a></li>\n</ol>\n</li>",
