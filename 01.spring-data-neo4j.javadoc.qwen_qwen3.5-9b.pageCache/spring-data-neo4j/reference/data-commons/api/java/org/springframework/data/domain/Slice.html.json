  "items": [
    {
      "source": "Returns the <a href=\"Pageable.html\" title=\"interface in org.springframework.data.domain\"><code>Pageable</code></a> that's been used to request the current <a href=\"Slice.html\" title=\"interface in org.springframework.data.domain\"><code>Slice</code></a>.",
      "translation": "返回用于请求当前<a href=\"Slice.html\" title=\"org.springframework.data.domain 中的接口\"><code>Slice</code></a>的<a href=\"Pageable.html\" title=\"org.springframework.data.domain 中的接口\"><code>Pageable</code></a>。",
      "count": 2
    },
    {
      "source": "Returns a new <a href=\"Slice.html\" title=\"interface in org.springframework.data.domain\"><code>Slice</code></a> with the content of the current one mapped by the given <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/core/convert/converter/Converter.html\" title=\"class or interface in org.springframework.core.convert.converter\"><code>Converter</code></a>.",
      "translation": "返回一个新的 <a href=\"Slice.html\" title=\"interface in org.springframework.data.domain\"><code>Slice</code></a>，其中包含通过给定的 <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/core/convert/converter/Converter.html\" title=\"class or interface in org.springframework.core.convert.converter\"><code>Converter</code></a> 映射的当前内容。",
      "count": 2
    },
    {
      "source": "Returns the page content as <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/List.html\" title=\"class or interface in java.util\"><code>List</code></a>.",
      "translation": "返回页面内容，即<a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/List.html\" title=\"java.util 中的类或接口\"><code>List</code></a>。",
      "count": 2
    },
    {
      "source": "Returns the number of elements currently on this <a href=\"Slice.html\" title=\"interface in org.springframework.data.domain\"><code>Slice</code></a>.",
      "translation": "返回当前此<a href=\"Slice.html\" title=\"org.springframework.data.domain 中的接口\"><code>Slice</code></a>上的元素数量。",
      "count": 2
    },
    {
      "source": "Returns the size of the <a href=\"Slice.html\" title=\"interface in org.springframework.data.domain\"><code>Slice</code></a>.",
      "translation": "返回<a href=\"Slice.html\" title=\"org.springframework.data.domain 中的接口\"><code>Slice</code></a>的大小。",
      "count": 2
    },
    {
      "source": "Returns the sorting parameters for the <a href=\"Slice.html\" title=\"interface in org.springframework.data.domain\"><code>Slice</code></a>.",
      "translation": "返回<a href=\"Slice.html\" title=\"org.springframework.data.domain 中的接口\"><code>Slice</code></a>的排序参数。",
      "count": 2
    },
    {
      "source": "Returns whether the <a href=\"Slice.html\" title=\"interface in org.springframework.data.domain\"><code>Slice</code></a> has content at all.",
      "translation": "返回 <a href=\"Slice.html\" title=\"org.springframework.data.domain 中的接口\"><code>Slice</code></a> 是否包含任何内容。",
      "count": 2
    },
    {
      "source": "Returns if there is a next <a href=\"Slice.html\" title=\"interface in org.springframework.data.domain\"><code>Slice</code></a>.",
      "translation": "如果存在下一个<a href=\"Slice.html\" title=\"org.springframework.data.domain 中的接口\"><code>Slice</code></a>，则返回该值。",
      "count": 2
    },
    {
      "source": "Returns if there is a previous <a href=\"Slice.html\" title=\"interface in org.springframework.data.domain\"><code>Slice</code></a>.",
      "translation": "如果存在之前的<a href=\"Slice.html\" title=\"org.springframework.data.domain 中的接口\"><code>Slice</code></a>，则返回该对象。",
      "count": 2
    },
    {
      "source": "Returns whether the current <a href=\"Slice.html\" title=\"interface in org.springframework.data.domain\"><code>Slice</code></a> is the first one.",
      "translation": "返回当前<a href=\"Slice.html\" title=\"org.springframework.data.domain 中的接口\"><code>Slice</code></a>是否为第一个。",
      "count": 2
    },
    {
      "source": "Returns whether the current <a href=\"Slice.html\" title=\"interface in org.springframework.data.domain\"><code>Slice</code></a> is the last one.",
      "translation": "返回当前<a href=\"Slice.html\" title=\"org.springframework.data.domain 中的接口\"><code>Slice</code></a>是否为最后一个。",
      "count": 2
    },
    {
      "source": "Returns the <a href=\"Pageable.html\" title=\"interface in org.springframework.data.domain\"><code>Pageable</code></a> describing the next slice or the one describing the current slice in case it's the\nlast one.",
      "translation": "返回描述下一个分片的<code>Pageable</code>，或者在它是最后一个分片时，返回描述当前分片的<code>Pageable</code>。",
      "count": 2
    },
    {
      "source": "Returns the <a href=\"Pageable.html\" title=\"interface in org.springframework.data.domain\"><code>Pageable</code></a> describing the previous slice or the one describing the current slice in case it's the\nfirst one.",
      "translation": "返回描述前一个切片或（如果是第一个切片时）描述当前切片的<a href=\"Pageable.html\" title=\"interface in org.springframework.data.domain\"><code>Pageable</code></a>。",
      "count": 2
    },
    {
