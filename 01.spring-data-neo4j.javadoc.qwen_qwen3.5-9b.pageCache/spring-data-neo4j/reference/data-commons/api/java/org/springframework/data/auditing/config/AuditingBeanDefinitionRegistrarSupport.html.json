    {
      "source": "Configures the given <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/beans/factory/support/BeanDefinitionBuilder.html\" title=\"class or interface in org.springframework.beans.factory.support\"><code>BeanDefinitionBuilder</code></a> with the default attributes from the given\n<a href=\"AuditingConfiguration.html\" title=\"interface in org.springframework.data.auditing.config\"><code>AuditingConfiguration</code></a>.",
      "translation": "使用给定的 <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/beans/factory/support/BeanDefinitionBuilder.html\" title=\"class or interface in org.springframework.beans.factory.support\"><code>BeanDefinitionBuilder</code></a> 和给定的 <a href=\"AuditingConfiguration.html\" title=\"interface in org.springframework.data.auditing.config\"><code>AuditingConfiguration</code></a> 中的默认属性进行配置。",
      "count": 2
    },
    {
      "source": "Creates a <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/beans/factory/support/BeanDefinitionBuilder.html\" title=\"class or interface in org.springframework.beans.factory.support\"><code>BeanDefinitionBuilder</code></a> to ease the definition of store specific <a href=\"../AuditingHandler.html\" title=\"class in org.springframework.data.auditing\"><code>AuditingHandler</code></a>\nimplementations.",
      "translation": "创建一个<a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/beans/factory/support/BeanDefinitionBuilder.html\" title=\"org.springframework.beans.factory.support 中的类或接口\"><code>BeanDefinitionBuilder</code></a>，以简化特定存储的<a href=\"../AuditingHandler.html\" title=\"org.springframework.data.auditing 中的类\"><code>AuditingHandler</code></a>实现的定义。",
      "count": 2
    },
    {
      "source": "Return the name to be used to register the <a href=\"../AuditingHandler.html\" title=\"class in org.springframework.data.auditing\"><code>AuditingHandler</code></a> under.",
      "translation": "返回用于注册<a href=\"../AuditingHandler.html\" title=\"org.springframework.data.auditing 中的类\"><code>AuditingHandler</code></a>的名称。",
      "count": 2
    },
    {
      "source": "Retrieve auditing configuration from the given <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/core/type/AnnotationMetadata.html\" title=\"class or interface in org.springframework.core.type\"><code>AnnotationMetadata</code></a>.",
      "translation": "从给定的 <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/core/type/AnnotationMetadata.html\" title=\"class or interface in org.springframework.core.type\"><code>AnnotationMetadata</code></a> 中检索审计配置。",
      "count": 2
    },
    {
      "source": "Registers an appropriate BeanDefinition for an <a href=\"../AuditingHandler.html\" title=\"class in org.springframework.data.auditing\"><code>AuditingHandler</code></a>.",
      "translation": "注册一个适用于<a href=\"../AuditingHandler.html\" title=\"class in org.springframework.data.auditing\"><code>AuditingHandler</code></a>的适当 BeanDefinition。",
      "count": 2
    },
    {
      "source": "Register the listener to eventually trigger the <a href=\"../AuditingHandler.html\" title=\"class in org.springframework.data.auditing\"><code>AuditingHandler</code></a>.",
      "translation": "注册监听器，以便最终触发<a href=\"../AuditingHandler.html\" title=\"class in org.springframework.data.auditing\"><code>AuditingHandler</code></a>。",
      "count": 2
    },
    {
      "source": "Registers the given <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/beans/factory/support/AbstractBeanDefinition.html\" title=\"class or interface in org.springframework.beans.factory.support\"><code>AbstractBeanDefinition</code></a> as infrastructure bean under the given id.",
