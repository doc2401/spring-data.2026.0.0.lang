      "count": 1
    },
    {
      "source": "Add a highest priority mapping that will associate a specific repository interface with a given\n<a href=\"../CouchbaseOperations.html\" title=\"interface in org.springframework.data.couchbase.core\"><code>CouchbaseOperations</code></a>.",
