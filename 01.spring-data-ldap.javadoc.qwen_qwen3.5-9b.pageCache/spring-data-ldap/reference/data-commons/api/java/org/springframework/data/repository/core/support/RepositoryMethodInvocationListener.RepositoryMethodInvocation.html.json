    {
      "source": "<code>repositoryInterface</code> - the repository interface that was used to call <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/reflect/Method.html\" title=\"class or interface in java.lang.reflect\"><code>Method</code></a>.",
      "translation": "<code>repositoryInterface</code> - 用于调用 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/reflect/Method.html\" title=\"java.lang.reflect 中的类或接口\"><code>Method</code></a> 的存储库接口。",
      "count": 1
    },
    {
      "source": "<code>durationNs</code> - the duration in <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/concurrent/TimeUnit.html#NANOSECONDS\" title=\"class or interface in java.util.concurrent\"><code>TimeUnit.NANOSECONDS</code></a>.",
      "translation": "<code>durationNs</code> - 以 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/concurrent/TimeUnit.html#NANOSECONDS\" title=\"class or interface in java.util.concurrent\"><code>TimeUnit.NANOSECONDS</code></a> 表示的持续时间。",
      "count": 1
    },
    {
      "source": "<code>method</code> - the actual method that was called.",
      "translation": "<code>method</code> - 实际被调用的方法。",
      "count": 1
    },
    {
      "source": "<code>result</code> - the outcome of the invocation. Must not be null.",
      "translation": "<code>result</code> - 调用的结果。不得为 null。",
