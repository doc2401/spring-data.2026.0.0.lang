  "items": [
    {
      "source": "Returns a <a href=\"ExposureConfigurer.html\" title=\"interface in org.springframework.data.rest.core.mapping\"><code>ExposureConfigurer</code></a> to allow the registration of type specific\n<a href=\"ExposureConfigurer.AggregateResourceHttpMethodsFilter.html\" title=\"interface in org.springframework.data.rest.core.mapping\"><code>ExposureConfigurer.AggregateResourceHttpMethodsFilter</code></a> and <a href=\"ExposureConfigurer.AssociationResourceHttpMethodsFilter.html\" title=\"interface in org.springframework.data.rest.core.mapping\"><code>ExposureConfigurer.AssociationResourceHttpMethodsFilter</code></a>s which means the\nconfigured filters will only be invoked for aggregates of the given type and properties owned by that type\nrespectively.",
      "translation": "返回一个 <a href=\"ExposureConfigurer.html\" title=\"interface in org.springframework.data.rest.core.mapping\"><code>ExposureConfigurer</code></a>，以允许注册特定类型的\n<a href=\"ExposureConfigurer.AggregateResourceHttpMethodsFilter.html\" title=\"interface in org.springframework.data.rest.core.mapping\"><code>ExposureConfigurer.AggregateResourceHttpMethodsFilter</code></a> 和 <a href=\"ExposureConfigurer.AssociationResourceHttpMethodsFilter.html\" title=\"interface in org.springframework.data.rest.core.mapping\"><code>ExposureConfigurer.AssociationResourceHttpMethodsFilter</code></a>，这意味着配置的过滤器将仅针对给定类型的聚合以及该类型所拥有的属性分别被调用。",
      "count": 2
    },
    {
      "source": "Returns whether PUT requests can be used to create new instances for the type backing the given\n<a href=\"ResourceMetadata.html\" title=\"interface in org.springframework.data.rest.core.mapping\"><code>ResourceMetadata</code></a>.",
      "translation": "返回是否可以使用 PUT 请求为给定 <a href=\"ResourceMetadata.html\" title=\"org.springframework.data.rest.core.mapping 中的接口\"><code>ResourceMetadata</code></a> 所支持的类型创建新实例。",
      "count": 2
    },
    {
      "source": "Disables the support for <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/http/HttpMethod.html#PATCH\" title=\"class or interface in org.springframework.http\"><code>HttpMethod.PATCH</code></a> for item resources.",
      "translation": "禁用对项资源的<a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/http/HttpMethod.html#PATCH\" title=\"class or interface in org.springframework.http\"><code>HttpMethod.PATCH</code></a>的支持。",
      "count": 2
    },
    {
      "source": "Disables the ability to create new item resources via <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/http/HttpMethod.html#PUT\" title=\"class or interface in org.springframework.http\"><code>HttpMethod.PUT</code></a>.",
      "translation": "禁用通过 <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/http/HttpMethod.html#PUT\" title=\"class or interface in org.springframework.http\"><code>HttpMethod.PUT</code></a> 创建新项资源的能力。",
      "count": 2
    },
    {
      "source": "Disables the support for <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/http/HttpMethod.html#PUT\" title=\"class or interface in org.springframework.http\"><code>HttpMethod.PUT</code></a> for item resources.",
      "translation": "禁用对项资源的<a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/http/HttpMethod.html#PUT\" title=\"class or interface in org.springframework.http\"><code>HttpMethod.PUT</code></a>支持。",
      "count": 2
    },
    {
      "source": "Registers the given <a href=\"ExposureConfigurer.AssociationResourceHttpMethodsFilter.html\" title=\"interface in org.springframework.data.rest.core.mapping\"><code>ExposureConfigurer.AssociationResourceHttpMethodsFilter</code></a>.",
      "translation": "注册给定的<a href=\"ExposureConfigurer.AssociationResourceHttpMethodsFilter.html\" title=\"org.springframework.data.rest.core.mapping 中的接口\"><code>ExposureConfigurer.AssociationResourceHttpMethodsFilter</code></a>。",
      "count": 2
    },
    {
      "source": "Registers the given <a href=\"ExposureConfigurer.AggregateResourceHttpMethodsFilter.html\" title=\"interface in org.springframework.data.rest.core.mapping\"><code>ExposureConfigurer.AggregateResourceHttpMethodsFilter</code></a> to be used for collection resources.",
      "translation": "注册给定的<a href=\"ExposureConfigurer.AggregateResourceHttpMethodsFilter.html\" title=\"org.springframework.data.rest.core.mapping 中的接口\"><code>ExposureConfigurer.AggregateResourceHttpMethodsFilter</code></a>，以便用于集合资源。",
      "count": 2
    },
    {
      "source": "Registers the given <a href=\"ExposureConfigurer.AggregateResourceHttpMethodsFilter.html\" title=\"interface in org.springframework.data.rest.core.mapping\"><code>ExposureConfigurer.AggregateResourceHttpMethodsFilter</code></a> to be used for item resources.",
      "translation": "注册给定的<a href=\"ExposureConfigurer.AggregateResourceHttpMethodsFilter.html\" title=\"org.springframework.data.rest.core.mapping 中的接口\"><code>ExposureConfigurer.AggregateResourceHttpMethodsFilter</code></a>，用于项目资源。",
      "count": 2
    },
    {
      "source": "Returns whether PUT requests can be used to create new instances of the given domain type.",
      "translation": "返回是否可以使用 PUT 请求创建给定域类型的新实例。",
      "count": 2
    },
