    {
      "source": "Create a <code>PersistenceUnitContext</code> from the given <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/orm/jpa/persistenceunit/PersistenceManagedTypes.html\" title=\"class or interface in org.springframework.orm.jpa.persistenceunit\"><code>PersistenceManagedTypes</code></a>.",
