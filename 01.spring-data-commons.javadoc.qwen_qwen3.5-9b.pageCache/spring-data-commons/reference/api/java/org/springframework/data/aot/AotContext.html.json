    {
      "source": "<code>identifyingAnnotations</code> - <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/Collection.html\" title=\"class or interface in java.util\"><code>Collection</code></a> of <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/annotation/Annotation.html\" title=\"class or interface in java.lang.annotation\"><code>Annotations</code></a> identifying store-specific model\n         <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Class.html\" title=\"class or interface in java.lang\"><code>types</code></a>; must not be null.",
      "translation": "<code>identifyingAnnotations</code> - 用于标识特定存储模型类型的 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/Collection.html\" title=\"class or interface in java.util\"><code>Collection</code></a>，其中包含 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/annotation/Annotation.html\" title=\"class or interface in java.lang.annotation\"><code>Annotations</code></a>；该值不得为 null。",
      "count": 1
    },
    {
      "source": "<code>typeName</code> - <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/String.html\" title=\"class or interface in java.lang\"><code>name</code></a> of the <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Class.html\" title=\"class or interface in java.lang\"><code>type</code></a> to evaluate; must not be null.",
      "translation": "<code>typeName</code> - 要评估的 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Class.html\" title=\"class or interface in java.lang\"><code>type</code></a> 的 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/String.html\" title=\"class or interface in java.lang\"><code>name</code></a>；不能为 null。",
      "count": 1
    },
    {
      "source": "<code>packageNames</code> - <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/Collection.html\" title=\"class or interface in java.util\"><code>Collection</code></a> of <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/String.html\" title=\"class or interface in java.lang\"><code>package names</code></a> to scan.",
      "translation": "<code>packageNames</code> - 要扫描的 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/Collection.html\" title=\"java.util 中的类或接口\"><code>Collection</code></a>，其中包含 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/String.html\" title=\"java.lang 中的类或接口\"><code>包名</code></a>。",
      "count": 1
    },
    {
      "source": "a reference to the <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/beans/factory/config/ConfigurableListableBeanFactory.html\" title=\"class or interface in org.springframework.beans.factory.config\"><code>ConfigurableListableBeanFactory</code></a> backing this <a href=\"AotContext.html\" title=\"interface in org.springframework.data.aot\"><code>AotContext</code></a>.",
      "translation": "对支持此<a href=\"AotContext.html\" title=\"org.springframework.data.aot 中的接口\"><code>AotContext</code></a>的<a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/beans/factory/config/ConfigurableListableBeanFactory.html\" title=\"org.springframework.beans.factory.config 中的类或接口\"><code>ConfigurableListableBeanFactory</code></a>的引用。",
      "count": 1
    },
    {
      "source": "<code><a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/IllegalStateException.html\" title=\"class or interface in java.lang\">IllegalStateException</a></code> - if no <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/ClassLoader.html\" title=\"class or interface in java.lang\"><code>ClassLoader</code></a> is available.",
      "translation": "<code><a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/IllegalStateException.html\" title=\"java.lang 中的类或接口\">IllegalStateException</a></code> - 如果不可用任何 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/ClassLoader.html\" title=\"java.lang 中的类或接口\"><code>ClassLoader</code></a>。",
      "count": 1
    },
    {
      "source": "a <a href=\"../util/TypeScanner.html\" title=\"interface in org.springframework.data.util\"><code>TypeScanner</code></a> used to scan for <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Class.html\" title=\"class or interface in java.lang\"><code>types</code></a> that will be contributed to the AOT processing\n        infrastructure.",
      "translation": "一个<a href=\"../util/TypeScanner.html\" title=\"interface in org.springframework.data.util\"><code>TypeScanner</code></a>用于扫描将贡献给 AOT 处理基础设施的<a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Class.html\" title=\"class or interface in java.lang\"><code>types</code></a>。",
      "count": 1
    },
    {
      "source": "a <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/Set.html\" title=\"class or interface in java.util\"><code>Set</code></a> of <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Class.html\" title=\"class or interface in java.lang\"><code>types</code></a> found during the scan.",
      "translation": "扫描期间发现的 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/util/Set.html\" title=\"java.util 中的类或接口\"><code>Set</code></a>，其中包含 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Class.html\" title=\"java.lang 中的类或接口\"><code>types</code></a>。",
      "count": 1
    },
    {
      "source": "<code>environment</code> - reference to the <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/core/env/Environment.html\" title=\"class or interface in org.springframework.core.env\"><code>Environment</code></a>; must not be null.",
      "translation": "<code>environment</code> - 对 <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/core/env/Environment.html\" title=\"org.springframework.core.env 中的类或接口\"><code>Environment</code></a> 的引用；不能为 null。",
      "count": 1
    },
    {
      "source": "<code>moduleName</code> - name of the module. Can be null or empty, in which case it will only check\n         the general <a href=\"#GENERATED_REPOSITORIES_ENABLED\"><code>GENERATED_REPOSITORIES_ENABLED</code></a> flag.",
      "translation": "<code>moduleName</code> - 模块名称。可以为 null 或空，此时将仅检查通用标志 <a href=\"#GENERATED_REPOSITORIES_ENABLED\"><code>GENERATED_REPOSITORIES_ENABLED</code></a>。",
      "count": 1
    },
    {
      "source": "<code>reference</code> - <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/beans/factory/config/BeanReference.html\" title=\"class or interface in org.springframework.beans.factory.config\"><code>BeanReference</code></a> to the managed bean.",
      "translation": "<code>reference</code> - 指向托管 Bean 的 <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/beans/factory/config/BeanReference.html\" title=\"org.springframework.beans.factory.config 中的类或接口\"><code>BeanReference</code></a>。",
      "count": 1
    },
    {
      "source": "<code>beanName</code> - <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/String.html\" title=\"class or interface in java.lang\"><code>String</code></a> containing the name of the bean to evaluate; must not be null.",
      "translation": "<code>beanName</code> - 包含待评估的 Bean 名称的 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/String.html\" title=\"class or interface in java.lang\"><code>String</code></a>；不能为 null。",
      "count": 1
    },
    {
      "source": "<code>resolvableType</code> - the resolvable type to configure.",
      "translation": "<code>resolvableType</code> - 要配置的可解析类型。",
      "count": 1
    },
    {
      "source": "<code>type</code> - the type to configure.",
      "translation": "<code>type</code> - 要配置的类型。",
      "count": 1
    },
    {
      "source": "<code>generationContext</code> - the context to contribute the type configurations to.",
      "translation": "<code>generationContext</code> - 用于贡献类型配置的上下文。",
      "count": 1
    },
    {
      "source": "Christoph Strobl, John Blum, Mark Paluch",
      "translation": "克里斯托夫·施特罗布，约翰·布鲁姆，马克·帕卢赫",
      "count": 1
    },
    {
      "source": "indicator if repository code generation is enabled.",
      "translation": "指示器，用于显示是否启用了仓库代码生成。",
      "count": 1
    },
    {
      "source": "indicator if repository metadata should be written",
      "translation": "指示是否应写入仓库元数据的标志",
      "count": 1
    },
    {
      "source": "the type introspector for further type-based introspection.",
      "translation": "用于进一步基于类型的类型检查器。",
      "count": 1
    },
    {
      "source": "Nested Class Summary",
      "translation": "嵌套类摘要",
      "count": 1
    },
    {
      "source": "Field Details",
      "translation": "字段详情",
      "count": 1
    },
    {
      "source": "The context in which the AOT processing happens. Grants access to the <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/beans/factory/config/ConfigurableListableBeanFactory.html\" title=\"class or interface in org.springframework.beans.factory.config\"><code>beanFactory</code></a> and <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/ClassLoader.html\" title=\"class or interface in java.lang\"><code>ClassLoader</code></a>.",
      "translation": "AOT 处理发生的上下文。授予对 <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.8/javadoc-api/org/springframework/beans/factory/config/ConfigurableListableBeanFactory.html\" title=\"class or interface in org.springframework.beans.factory.config\"><code>beanFactory</code></a> 和 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/ClassLoader.html\" title=\"class or interface in java.lang\"><code>ClassLoader</code></a> 的访问权限。",
      "count": 1
    }
  ]
}