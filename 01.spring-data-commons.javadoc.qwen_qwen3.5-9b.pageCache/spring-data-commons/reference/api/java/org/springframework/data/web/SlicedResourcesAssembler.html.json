    {
      "source": "<code><a class=\"external-link\" href=\"https://docs.spring.io/spring-hateoas/docs/current/api/org/springframework/hateoas/server/RepresentationModelAssembler.html#toModel(T)\" title=\"class or interface in org.springframework.hateoas.server\">toModel</a></code> in interface <code><a class=\"external-link\" href=\"https://docs.spring.io/spring-hateoas/docs/current/api/org/springframework/hateoas/server/RepresentationModelAssembler.html\" title=\"class or interface in org.springframework.hateoas.server\">RepresentationModelAssembler</a>&lt;<a href=\"../domain/Slice.html\" title=\"interface in org.springframework.data.domain\">Slice</a>&lt;<a href=\"#type-param-T\" title=\"type parameter in SlicedResourcesAssembler\">T</a>&gt;, <a class=\"external-link\" href=\"https://docs.spring.io/spring-hateoas/docs/current/api/org/springframework/hateoas/SlicedModel.html\" title=\"class or interface in org.springframework.hateoas\">SlicedModel</a>&lt;<a class=\"external-link\" href=\"https://docs.spring.io/spring-hateoas/docs/current/api/org/springframework/hateoas/EntityModel.html\" title=\"class or interface in org.springframework.hateoas\">EntityModel</a>&lt;<a href=\"#type-param-T\" title=\"type parameter in SlicedResourcesAssembler\">T</a>&gt;&gt;&gt;</code>",
      "translation": "<code><a class=\"external-link\" href=\"https://docs.spring.io/spring-hateoas/docs/current/api/org/springframework/hateoas/server/RepresentationModelAssembler.html#toModel(T)\" title=\"类或接口 org.springframework.hateoas.server\">toModel</a></code> 在接口 <code><a class=\"external-link\" href=\"https://docs.spring.io/spring-hateoas/docs/current/api/org/springframework/hateoas/server/RepresentationModelAssembler.html\" title=\"类或接口 org.springframework.hateoas.server\">RepresentationModelAssembler</a>&lt;<a href=\"../domain/Slice.html\" title=\"接口 org.springframework.data.domain\">Slice</a>&lt;<a href=\"#type-param-T\" title=\"SlicedResourcesAssembler 中的类型参数\">T</a>&gt;, <a class=\"external-link\" href=\"https://docs.spring.io/spring-hateoas/docs/current/api/org/springframework/hateoas/SlicedModel.html\" title=\"类或接口 org.springframework.hateoas\">SlicedModel</a>&lt;<a class=\"external-link\" href=\"https://docs.spring.io/spring-hateoas/docs/current/api/org/springframework/hateoas/EntityModel.html\" title=\"类或接口 org.springframework.hateoas\">EntityModel</a>&lt;<a href=\"#type-param-T\" title=\"SlicedResourcesAssembler 中的类型参数\">T</a>&gt;&gt;&gt;</code>",
