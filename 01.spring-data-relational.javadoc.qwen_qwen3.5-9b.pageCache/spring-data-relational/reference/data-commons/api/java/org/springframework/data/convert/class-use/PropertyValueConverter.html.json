      "count": 1
    },
    {
      "source": "Register the <a href=\"../PropertyValueConverter.html\" title=\"interface in org.springframework.data.convert\"><code>PropertyValueConverter</code></a> for the <a href=\"../../mapping/PersistentProperty.html\" title=\"interface in org.springframework.data.mapping\"><code>property</code></a> of the given type.",
