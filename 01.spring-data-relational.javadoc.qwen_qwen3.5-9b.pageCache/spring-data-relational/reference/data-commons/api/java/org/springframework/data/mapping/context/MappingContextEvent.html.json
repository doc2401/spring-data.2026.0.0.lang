    },
    {
      "source": "<span id=\"type-param-P\"><code>P</code> - the <a href=\"../PersistentProperty.html\" title=\"interface in org.springframework.data.mapping\"><code>PersistentProperty</code></a> the <a href=\"../PersistentEntity.html\" title=\"interface in org.springframework.data.mapping\"><code>PersistentEntity</code></a> consists of</span>",
