    {
      "source": "<code><a href=\"OffsetScrollPositionArgumentResolver.html#resolveArgument(org.springframework.core.MethodParameter,org.springframework.web.method.support.ModelAndViewContainer,org.springframework.web.context.request.NativeWebRequest,org.springframework.web.bind.support.WebDataBinderFactory)\">resolveArgument</a></code> in interface <code><a href=\"OffsetScrollPositionArgumentResolver.html\" title=\"interface in org.springframework.data.web\">OffsetScrollPositionArgumentResolver</a></code>",
