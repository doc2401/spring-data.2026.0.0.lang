      "count": 2
    },
    {
      "source": "Register a <a href=\"../../core/mapping/JdbcMappingContext.html\" title=\"class in org.springframework.data.jdbc.core.mapping\"><code>JdbcMappingContext</code></a> and apply an optional <a href=\"../../../relational/core/mapping/NamingStrategy.html\" title=\"interface in org.springframework.data.relational.core.mapping\"><code>NamingStrategy</code></a>.",
