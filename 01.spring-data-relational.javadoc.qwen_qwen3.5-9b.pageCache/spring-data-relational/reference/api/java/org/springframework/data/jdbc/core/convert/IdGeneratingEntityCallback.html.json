      "translation": "<span class=\"description-from-type-label\">描述从接口复制：<code><a href=\"../../../relational/core/mapping/event/BeforeSaveCallback.html#onBeforeSave(T,org.springframework.data.relational.core.conversion.MutableAggregateChange)\">BeforeSaveCallback</a></code></span>",
      "count": 1
    },
