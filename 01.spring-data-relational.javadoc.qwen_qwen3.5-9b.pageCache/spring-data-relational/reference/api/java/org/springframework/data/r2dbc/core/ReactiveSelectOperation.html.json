      "count": 1
    },
    {
      "source": "The <a href=\"ReactiveSelectOperation.html\" title=\"interface in org.springframework.data.r2dbc.core\"><code>ReactiveSelectOperation</code></a> interface allows creation and execution of <code>SELECT</code> operations in a fluent\nAPI style.",
      "translation": "<a href=\"ReactiveSelectOperation.html\" title=\"org.springframework.data.r2dbc.core 中的接口\"><code>ReactiveSelectOperation</code></a> 接口允许以流式 API 风格创建和执行 <code>SELECT</code> 操作。",
      "count": 1
    },
    {
      "source": "<pre>    <code>\n        select(Human.class)\n            .withFetchSize(10)\n            .from(\"star_wars\")\n            .as(Jedi.class)\n            .matching(query(where(\"firstname\").is(\"luke\")))\n            .all();\n    </code>\n</pre>",
      "translation": "<pre>\n    <code>\n        select(Human.class)\n            .withFetchSize(10)\n            .from(\"star_wars\")\n            .as(Jedi.class)\n            .matching(query(where(\"firstname\").is(\"luke\")))\n            .all();\n    </code>\n</pre>",
      "count": 1
