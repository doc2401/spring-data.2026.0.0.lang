    {
      "source": "The <a href=\"ReactiveUpdateOperation.html\" title=\"interface in org.springframework.data.r2dbc.core\"><code>ReactiveUpdateOperation</code></a> interface allows creation and execution of <code>UPDATE</code> operations in a fluent\nAPI style.",
      "translation": "<a href=\"ReactiveUpdateOperation.html\" title=\"org.springframework.data.r2dbc.core 中的接口\"><code>ReactiveUpdateOperation</code></a> 接口允许以流畅的 API 风格创建并执行 <code>UPDATE</code> 操作。",
      "count": 1
    },
    {
      "source": "<pre>    <code>\n        update(Jedi.class)\n            .table(\"star_wars\")\n            .matching(query(where(\"firstname\").is(\"luke\")))\n            .apply(update(\"lastname\", \"skywalker\"))\n            .all();\n    </code>\n</pre>",
      "translation": "<pre>\n<code>\n        update(Jedi.class)\n            .table(\"star_wars\")\n            .matching(query(where(\"firstname\").is(\"luke\")))\n            .apply(update(\"lastname\", \"skywalker\"))\n            .all();\n</code>\n</pre>",
